{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["tools/**", "kits/**/*.mjs", "sheet/*.js", "sheet/*.mjs", "package.json", "biome.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "none", "arrowParentheses": "asNeeded" }
  }
}
