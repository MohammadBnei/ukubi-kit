{
  "name": "ukubi-kit",
  "private": true,
  "type": "module",
  "description": "The game's 3D kit: CC0 models repainted into civ styles, a catalog and a Go package that embeds them.",
  "license": "CC0-1.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun tools/build.mjs",
    "check": "bun tools/build.mjs --check",
    "lock": "bun tools/build.mjs --lock",
    "test": "bun test ./tools"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "pngjs": "7.0.0",
    "yaml": "2.9.1"
  }
}
